{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unilab.dev/contracts/runtime/v1/workflow-change-proposal.schema.json",
  "title": "Uni-Lab Workflow Change Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "base_revision_id",
    "schema_version",
    "format",
    "summary",
    "model_metadata"
  ],
  "properties": {
    "proposal_id": { "type": "string", "minLength": 1 },
    "base_revision_id": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "runtime/v1" },
    "format": { "enum": ["python_source", "ir_patch"] },
    "python_source": { "type": "string" },
    "ir_patch": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "string" },
    "model_metadata": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": { "format": { "const": "python_source" } },
      "required": ["python_source"],
      "not": { "required": ["ir_patch"] }
    },
    {
      "properties": { "format": { "const": "ir_patch" } },
      "required": ["ir_patch"],
      "not": { "required": ["python_source"] }
    }
  ]
}
